{
    "name": "@diia-inhouse/crypto",
    "version": "2.2.21",
    "description": "Tools for encryption and auth",
    "license": "SEE LICENSE IN LICENSE.md",
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-pkg-crypto",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsdown",
        "semantic-release": "semantic-release",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "prepare": "npm run build",
        "test": "tsc --project tests/tsconfig.json --noEmit && vitest run",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "@types/jsonwebtoken": "9.0.10",
        "jsonwebtoken": "9.0.3",
        "node-jose": "2.2.0"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.2.5",
        "@diia-inhouse/diia-logger": "4.7.56",
        "@diia-inhouse/errors": "2.3.45",
        "@diia-inhouse/oxc-config": "6.1.3",
        "@diia-inhouse/test": "8.4.11",
        "@diia-inhouse/types": "14.13.0",
        "@diia-inhouse/utils": "6.2.21",
        "@diia-inhouse/validators": "2.2.140",
        "@types/node": "25.9.9",
        "@types/node-jose": "1.1.13",
        "@vitest/coverage-v8": "4.1.11",
        "@vitest/ui": "4.1.11",
        "glob": "14.0.6",
        "lockfile-lint": "5.1.0",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "oxlint-tsgolint": "7.0.2007",
        "rimraf": "6.1.4",
        "tsdown": "0.23.7",
        "vitest": "4.1.11",
        "vitest-mock-extended": "6.0.1"
    },
    "peerDependencies": {
        "@diia-inhouse/errors": ">=1.0.0",
        "@diia-inhouse/types": ">=2.8.1",
        "@diia-inhouse/utils": ">=2.1.0"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "engines": {
        "node": ">=24"
    }
}
